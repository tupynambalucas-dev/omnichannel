# ============================================================================== #
#                    Tupynambalucas - ENVIRONMENT CONFIGURATION                  #
# ============================================================================== #
#                                                                                #
#  This file centralizes all runtime configurations, secret references, cloud    #
#  datastore endpoints, and Agent Mesh MCP credentials for the                   #
#  @tupynambalucas-dev/omnichannel monorepo.                                     #
#                                                                                #
# ============================================================================== #


# ------------------------------------------------------------------------------ #
# 1. HTTP SERVER & RUNTIME (@tupynambalucas-dev/omnichannel-api)
# ------------------------------------------------------------------------------ #

# -- Node.js runtime environment (development | production | test)
NODE_ENV=<YOUR_NODE_ENV>

# -- Fastify HTTP bind interface and port
SERVER_HOST=<YOUR_SERVER_HOST>
SERVER_PORT=<YOUR_SERVER_PORT>

# -- Pino structured logger verbosity (fatal | error | warn | info | debug | trace)
LOG_LEVEL=<YOUR_LOG_LEVEL>

# -- Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=<YOUR_CORS_ALLOWED_ORIGINS>


# ------------------------------------------------------------------------------ #
# 2. META GRAPH UNIFIED GATEWAY (WhatsApp Cloud API & Instagram Messaging API)
# ------------------------------------------------------------------------------ #

# -- Base URL and API version for outbound Meta Graph API calls
META_GRAPH_BASE_URL=<YOUR_META_GRAPH_BASE_URL>
META_GRAPH_API_VERSION=<YOUR_META_GRAPH_API_VERSION>

# -- Webhook challenge verification token (GET /webhooks/meta) and HMAC App Secret
META_WEBHOOK_VERIFY_TOKEN=<YOUR_META_WEBHOOK_VERIFY_TOKEN>
META_APP_SECRET=<YOUR_META_APP_SECRET>

# -- Default auto-bootstrap configuration for tupynamba-lucas-enterprise tenant
DEFAULT_TENANT_AUTO_BOOTSTRAP=<YOUR_DEFAULT_TENANT_AUTO_BOOTSTRAP>
DEFAULT_WHATSAPP_PHONE_NUMBER_ID=<YOUR_DEFAULT_WHATSAPP_PHONE_NUMBER_ID>

# -- Runtime secret reference resolved via tenant_channels.access_token_secret_ref
META_GRAPH_ACCESS_TOKEN=<YOUR_META_GRAPH_ACCESS_TOKEN>

# -- Offline simulation flag: bypasses real Meta Graph API calls for local testing (true | false)
META_GRAPH_MOCK_DISPATCH=<YOUR_META_GRAPH_MOCK_DISPATCH>


# ------------------------------------------------------------------------------ #
# 3. CLOUD POSTGRESQL (Primary ACID Store & Row-Level Security)
# ------------------------------------------------------------------------------ #

# -- Cloud PostgreSQL 16+ connection string (Neon / Supabase with app_runtime role)
DATABASE_URL=<YOUR_DATABASE_URL>
DATABASE_SSL_ENABLED=<YOUR_DATABASE_SSL_ENABLED>
DATABASE_POOL_MAX=<YOUR_DATABASE_POOL_MAX>


# ------------------------------------------------------------------------------ #
# 4. CLOUD REDIS DUAL-ROLE ISOLATION (TLS rediss://)
# ------------------------------------------------------------------------------ #

# -- Queue Redis for BullMQ workers (MUST use maxmemory-policy=noeviction)
REDIS_QUEUE_URL=<YOUR_REDIS_QUEUE_URL>

# -- State Redis for 24h webhook dedup, FIFO mutex locks, and FSM session cache (volatile-ttl)
REDIS_STATE_URL=<YOUR_REDIS_STATE_URL>


# ------------------------------------------------------------------------------ #
# 5. OPTIONAL CLOUD MONGODB ATLAS & OBSERVABILITY
# ------------------------------------------------------------------------------ #

# -- Unstructured raw webhook telemetry archive (strictly opt-in)
MONGODB_ARCHIVE_ENABLED=<YOUR_MONGODB_ARCHIVE_ENABLED>
MONGODB_URI=<YOUR_MONGODB_URI>

# -- Sentry DSN for 5xx unhandled exception reporting
SENTRY_DSN=<YOUR_SENTRY_DSN>


# ------------------------------------------------------------------------------ #
# 6. AGENT MESH & SOVEREIGN MCP SERVERS (Developer Workspace Tooling)
# ------------------------------------------------------------------------------ #

# -- GitHub Organization & GitHub Apps (mcp-github-org / mcp-github-flow)
GITHUB_ORG=<YOUR_GITHUB_ORG>
ORG_MANAGER_APP_ID=<YOUR_ORG_MANAGER_APP_ID>
ORG_MANAGER_APP_CLIENT_ID=<YOUR_ORG_MANAGER_APP_CLIENT_ID>
ORG_MANAGER_APP_INSTALLATION_ID=<YOUR_ORG_MANAGER_APP_INSTALLATION_ID>
ORG_MANAGER_APP_PRIVATE_KEY_BASE64=<YOUR_ORG_MANAGER_APP_PRIVATE_KEY_BASE64>
ORG_MANAGER_APP_PRIVATE_KEY_PATH=<YOUR_ORG_MANAGER_APP_PRIVATE_KEY_PATH>
CI_BOT_APP_ID=<YOUR_CI_BOT_APP_ID>
CI_BOT_APP_CLIENT_ID=<YOUR_CI_BOT_APP_CLIENT_ID>
CI_BOT_APP_INSTALLATION_ID=<YOUR_CI_BOT_APP_INSTALLATION_ID>
CI_BOT_APP_PRIVATE_KEY_BASE64=<YOUR_CI_BOT_APP_PRIVATE_KEY_BASE64>
CI_BOT_APP_PRIVATE_KEY_PATH=<YOUR_CI_BOT_APP_PRIVATE_KEY_PATH>
DEVELOPER_TOOLS_APP_ID=<YOUR_DEVELOPER_TOOLS_APP_ID>
DEVELOPER_TOOLS_APP_CLIENT_ID=<YOUR_DEVELOPER_TOOLS_APP_CLIENT_ID>
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>
MESH_ALLOW_UNSAFE_GIT=<YOUR_MESH_ALLOW_UNSAFE_GIT>

# -- Documentation & Web Research (Context7 / mcp-firecrawl)
CONTEXT7_API_KEY=<YOUR_CONTEXT7_API_KEY>
FIRECRAWL_API_KEY=<YOUR_FIRECRAWL_API_KEY>
FIRECRAWL_API_URL=<YOUR_FIRECRAWL_API_URL>
MESH_ALLOW_NATIVE_WEB=<YOUR_MESH_ALLOW_NATIVE_WEB>

# -- Playwright Browser Automation (mcp-playwright)
PLAYWRIGHT_MODE=<YOUR_PLAYWRIGHT_MODE>
PLAYWRIGHT_MCP_EXTENSION_TOKEN=<YOUR_PLAYWRIGHT_MCP_EXTENSION_TOKEN>
PLAYWRIGHT_CHANNEL=<YOUR_PLAYWRIGHT_CHANNEL>
PLAYWRIGHT_HEADLESS=<YOUR_PLAYWRIGHT_HEADLESS>
PLAYWRIGHT_CDP_URL=<YOUR_PLAYWRIGHT_CDP_URL>
PLAYWRIGHT_MCP_EXECUTABLE_PATH=<YOUR_PLAYWRIGHT_MCP_EXECUTABLE_PATH>

# -- Google AppSheet & Google Workspace (mcp-appsheet / mcp-gwork)
APPSHEET_APP_ID=<YOUR_APPSHEET_APP_ID>
APPSHEET_APPLICATION_ACCESS_KEY=<YOUR_APPSHEET_APPLICATION_ACCESS_KEY>
APPSHEET_APP_KEY=<YOUR_APPSHEET_APP_KEY>
APPSHEET_API_URL=<YOUR_APPSHEET_API_URL>
GOOGLE_SERVICE_ACCOUNT_JSON=<YOUR_GOOGLE_SERVICE_ACCOUNT_JSON>
GOOGLE_APPLICATION_CREDENTIALS=<YOUR_GOOGLE_APPLICATION_CREDENTIALS>
GOOGLE_DRIVE_FOLDER_ID=<YOUR_GOOGLE_DRIVE_FOLDER_ID>

# -- Infisical Cloud Vault (mcp-infisical)
INFISICAL_HOST_URL=<YOUR_INFISICAL_HOST_URL>
INFISICAL_AUTH_METHOD=<YOUR_INFISICAL_AUTH_METHOD>
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=<YOUR_INFISICAL_UNIVERSAL_AUTH_CLIENT_ID>
INFISICAL_CLIENT_ID=<YOUR_INFISICAL_CLIENT_ID>
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=<YOUR_INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET>
INFISICAL_CLIENT_SECRET=<YOUR_INFISICAL_CLIENT_SECRET>
INFISICAL_PROJECT_ID=<YOUR_INFISICAL_PROJECT_ID>
INFISICAL_ENVIRONMENT=<YOUR_INFISICAL_ENVIRONMENT>

# -- Atelier & Cortex Agent Mesh Governance
MESH_ALLOW_UNSAFE_ATELIER=<YOUR_MESH_ALLOW_UNSAFE_ATELIER>
MAX_SKILL_NAME_LENGTH=<YOUR_MAX_SKILL_NAME_LENGTH>
MAX_DESCRIPTION_LENGTH=<YOUR_MAX_DESCRIPTION_LENGTH>
MAX_COMPATIBILITY_LENGTH=<YOUR_MAX_COMPATIBILITY_LENGTH>
MAX_SKILL_MD_LINES=<YOUR_MAX_SKILL_MD_LINES>
MESH_PROFILE=<YOUR_MESH_PROFILE>
CORTEX_GATEWAY_URL=<YOUR_CORTEX_GATEWAY_URL>
TUPYNAMBA_GATEWAY_TOKEN=<YOUR_TUPYNAMBA_GATEWAY_TOKEN>
AGENT_MESH_LOG_LEVEL=<YOUR_AGENT_MESH_LOG_LEVEL>
MCP_TRANSPORT=<YOUR_MCP_TRANSPORT>
MEMORY_API_URL=<YOUR_MEMORY_API_URL>
MEMORY_MCP_PORT=<YOUR_MEMORY_MCP_PORT>
