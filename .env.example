# ==============================================================================
# @tupynambalucas-dev/omnichannel - Cloud-Native Environment Configuration
# ==============================================================================
# Zero-Docker Cloud Architecture:
# - PostgreSQL: Neon Serverless Postgres or Supabase Postgres (ACID + JSONB + RLS)
# - Redis (Queue): Upstash Redis or Redis Cloud (maxmemory-policy: noeviction)
# - Redis (State): Upstash Redis or Redis Cloud (maxmemory-policy: volatile-ttl)
# - MongoDB (Optional): MongoDB Atlas M0/Serverless (raw webhook archive only)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Meta Graph Unified Gateway (WhatsApp Cloud API + Instagram Messaging API)
# ------------------------------------------------------------------------------
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=replace_with_high_entropy_verify_token
META_APP_SECRET=replace_with_meta_app_secret

# ------------------------------------------------------------------------------
# 3. Cloud PostgreSQL (Primary Transactional Store + Row-Level Security)
# ------------------------------------------------------------------------------
# Example (Neon): postgresql://app_runtime:PASSWORD@ep-example.us-east-2.aws.neon.tech/omnichannel?sslmode=require
DATABASE_URL=
DATABASE_SSL_ENABLED=true
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 4. Cloud Redis Dual-Role Isolation (TLS rediss:// supported out of the box)
# ------------------------------------------------------------------------------
# Queue Redis MUST use maxmemory-policy=noeviction for BullMQ job integrity
REDIS_QUEUE_URL=
# State Redis uses volatile-ttl / volatile-lru for 24h webhook dedup & FSM sessions
REDIS_STATE_URL=

# ------------------------------------------------------------------------------
# 5. Optional Cloud MongoDB Atlas (Unstructured Payload Telemetry Archive)
# ------------------------------------------------------------------------------
MONGODB_ARCHIVE_ENABLED=false
MONGODB_URI=

# ------------------------------------------------------------------------------
# 6. Observability (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
